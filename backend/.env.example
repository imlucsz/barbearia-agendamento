DATABASE_URL=sqlite:///./barbearia.db
# Comma-separated HTTP(S) origins. Production must replace this local origin
# with the exact public HTTPS frontend origin(s).
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500
# Comma-separated HTTP Host allowlist; blank keeps local development open; required in production.
ALLOWED_HOSTS=
# Generate once and keep the same value in backend/.env across restarts.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
TERMS_VERSION=1.0
# direct ignores forwarded headers; cf-connecting-ip trusts one validated edge header.
CLIENT_IP_SOURCE=direct
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_BLOCK_MINUTES=15
RETENTION_DAYS=365
# Optional bearer token for Prometheus scraping. Leave blank to disable /metrics.
# Use at least 32 random characters and keep it in the monitoring secret store.
METRICS_TOKEN=
# Defaults to true in production and false in development/test.
FORCE_HTTPS=
APP_ENV=development
INSTALLATION_NAME=Barbearia
# IANA timezone used to interpret the barbershop schedule.
SCHEDULING_TIMEZONE=America/Sao_Paulo

# Leave these blank to disable email in local development. Production requires
# an SMTP host, sender address, and public HTTPS reset URL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=10
PASSWORD_RESET_URL=
