DATABASE_URL=sqlite:///./barbearia.db
# Comma-separated HTTP(S) origins. Production must replace this local origin
# with the exact public HTTPS frontend origin(s).
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500
# Generate once and keep the same value in backend/.env across restarts.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
APP_ENV=development
# IANA timezone used to interpret the barbershop schedule.
SCHEDULING_TIMEZONE=America/Sao_Paulo

# Leave these blank to disable email in local development. Production requires
# an SMTP host, sender address, and public HTTPS reset URL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=10
PASSWORD_RESET_URL=
